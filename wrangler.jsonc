{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appr",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "7f9190cd-64dd-48a0-989a-ce63ab398c03","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "83a778c635574fedbfc18078ce0f3012" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
